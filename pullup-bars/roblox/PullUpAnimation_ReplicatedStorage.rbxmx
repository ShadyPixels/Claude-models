<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Folder" referent="RBX00000004"><Properties><string name="Name">PullUp</string></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Settings for the pull-up bars. Server and clients both read this.
return {
	-- "Auto": reps keep going until the player lets go.
	-- "Tap":  each click / tap / R2 press does one rep.
	Mode = "Auto",

	-- Seconds per rep. Lower is faster.
	Tempo = 1.8,
	-- Optional per-tier tempo, e.g. { [8] = 1.5, [9] = 1.4 }
	TempoByTier = {},

	-- If the player has leaderstats with this value, each rep adds RewardByTier[tier].
	-- Set Leaderstat to nil to only use the PullUpRep event (see the README).
	Leaderstat = "Strength",
	RewardByTier = { 1, 2, 4, 7, 12, 20, 35, 60, 100 },

	-- Proximity prompt
	PromptKey = Enum.KeyCode.E,
	PromptGamepadKey = Enum.KeyCode.ButtonX,
	PromptDistance = 9,

	-- Show a small "reps / let go" label for the player on the bar
	ShowHud = true,

	-- Personal pull-up bars that upgrade in order: Basic -> Inferno -> Celestial -> Void
	-- -> Frostbite -> Stormcastle -> Arcane -> Blood Moon -> Toxic.
	Shop = {
		Enabled = true,

		-- leaderstats value used to pay for upgrades
		Currency = "Cash",
		-- Price to unlock each tier, in order. Tier 1 is the free starter bar.
		Prices = { 0, 500, 2500, 10000, 40000, 150000, 500000, 2000000, 10000000 },

		-- Saves each player's tier. Set to nil if your own data system saves it and
		-- calls PullUpBarShop.SetTier(player, tier) when the player joins.
		DataStoreName = "PullUpBarTier_v1",

		-- Only the owner can use (and upgrade) their bar.
		OwnerOnly = true,

		-- Upgrade prompt on each player's bar
		UpgradeKey = Enum.KeyCode.F,
		UpgradeGamepadKey = Enum.KeyCode.ButtonY,

		-- Where personal bars go: any parts tagged "PullUpBarSpot". If the place has
		-- none, this many spots are created in a row in front of the SpawnLocation.
		AutoSpots = 8,
		SpotSpacing = 16,
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">PullUpRig</string><ProtectedString name="Source"><![CDATA[--!nonstrict
--[[
	PullUpRig

	Measures an R15 character and turns high-level pose parameters (where the
	shoulders are, how far the torso leans, how bent the knees are ...) into
	Motor6D.Transform values.

	The arms are solved with two-bone IK every frame, so the hands stay locked
	on the grip bar for any avatar size or body proportions. The legs use IK
	only while the feet are planted (crouch / landing) and simple FK while
	hanging.

	Nothing here touches the network or RunService; it is pure math, so the
	same code drives the live animation (PullUpClient) and the bake tool.
]]

local PullUpRig = {}
PullUpRig.__index = PullUpRig

local IDENTITY = CFrame.new()
local UP = Vector3.new(0, 1, 0)
local X_AXIS = Vector3.new(1, 0, 0)

-- Motor6D name -> the part it lives in (its Part1)
PullUpRig.MOTORS = {
	{ part = "LowerTorso", name = "Root" },
	{ part = "UpperTorso", name = "Waist" },
	{ part = "Head", name = "Neck" },
	{ part = "LeftUpperArm", name = "LeftShoulder" },
	{ part = "LeftLowerArm", name = "LeftElbow" },
	{ part = "LeftHand", name = "LeftWrist" },
	{ part = "RightUpperArm", name = "RightShoulder" },
	{ part = "RightLowerArm", name = "RightElbow" },
	{ part = "RightHand", name = "RightWrist" },
	{ part = "LeftUpperLeg", name = "LeftHip" },
	{ part = "LeftLowerLeg", name = "LeftKnee" },
	{ part = "LeftFoot", name = "LeftAnkle" },
	{ part = "RightUpperLeg", name = "RightHip" },
	{ part = "RightLowerLeg", name = "RightKnee" },
	{ part = "RightFoot", name = "RightAnkle" },
}

local ARMS = {
	Left = { "LeftShoulder", "LeftElbow", "LeftWrist", sign = -1 },
	Right = { "RightShoulder", "RightElbow", "RightWrist", sign = 1 },
}
local LEGS = {
	Left = { "LeftHip", "LeftKnee", "LeftAnkle", sign = -1 },
	Right = { "RightHip", "RightKnee", "RightAnkle", sign = 1 },
}

---------------------------------------------------------------------------
-- math helpers
---------------------------------------------------------------------------

-- Rotation whose Y axis points along `dir` and whose X axis is as close to
-- `hinge` as possible. Bones are matched by mapping a local basis onto a
-- world basis built the same way.
local function basis(hinge, dir)
	local b = dir.Unit
	local x = hinge - b * hinge:Dot(b)
	if x.Magnitude < 1e-5 then
		x = UP:Cross(b)
		if x.Magnitude < 1e-5 then
			x = X_AXIS
		end
	end
	x = x.Unit
	return CFrame.fromMatrix(Vector3.new(), x, b, x:Cross(b))
end

-- Two-bone IK. a = root joint, c = desired end joint, pole = which way the
-- middle joint should point. Returns middle joint, reachable end joint and
-- the hinge axis of the chain.
local function solveChain(a, c, l1, l2, pole)
	local ac = c - a
	local d = ac.Magnitude
	local dir = d > 1e-4 and ac / d or -UP
	-- Soft IK: ease into full extension instead of snapping straight, which
	-- removes the classic knee/elbow "pop" when a limb is nearly straight.
	local maxD = l1 + l2 - 1e-3
	local soft = 0.05 * (l1 + l2)
	if d > maxD - soft then
		d = maxD - soft + soft * (1 - math.exp(-(d - (maxD - soft)) / soft))
	end
	d = math.max(d, math.abs(l1 - l2) + 1e-3)
	c = a + dir * d
	local along = (l1 * l1 - l2 * l2 + d * d) / (2 * d)
	local h = math.sqrt(math.max(0, l1 * l1 - along * along))
	local toPole = pole - a
	local perp = toPole - dir * toPole:Dot(dir)
	if perp.Magnitude < 1e-5 then
		perp = dir:Cross(X_AXIS)
		if perp.Magnitude < 1e-5 then
			perp = dir:Cross(UP)
		end
	end
	perp = perp.Unit
	local b = a + dir * along + perp * h
	local n = (b - a):Cross(c - b)
	if n.Magnitude < 1e-6 then
		n = -(c - a):Cross(toPole)
	end
	if n.Magnitude < 1e-6 then
		n = X_AXIS
	end
	return b, c, n.Unit
end

-- World CFrame of a bone whose joint (jointLocal, in the part's space) sits at
-- `joint`, pointing along `dir`, with its hinge on `hinge`.
local function placeBone(joint, dir, hinge, localBasis, jointLocal)
	local r = basis(hinge, dir) * localBasis:Inverse()
	return CFrame.new(joint) * r * CFrame.new(-jointLocal)
end

local function unitOr(v, fallback)
	if v.Magnitude < 1e-5 then
		return fallback
	end
	return v.Unit
end

---------------------------------------------------------------------------
-- construction
---------------------------------------------------------------------------

-- Returns a rig, or nil plus a reason when the character can't do pull-ups.
function PullUpRig.new(character)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return nil, "no Humanoid"
	end
	if humanoid.RigType ~= Enum.HumanoidRigType.R15 then
		return nil, "R15 character required"
	end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	local head = character:FindFirstChild("Head")
	local upperTorso = character:FindFirstChild("UpperTorso")
	if not (hrp and head and upperTorso) then
		return nil, "character not loaded"
	end

	local self = setmetatable({
		character = character,
		humanoid = humanoid,
		hrp = hrp,
		motors = {},
		c0 = {},
		c1 = {},
	}, PullUpRig)

	for _, j in PullUpRig.MOTORS do
		local part = character:FindFirstChild(j.part)
		local motor = part and part:FindFirstChild(j.name)
		if not (motor and motor:IsA("Motor6D")) then
			return nil, "missing joint " .. j.name
		end
		self.motors[j.name] = motor
		self.c0[j.name] = motor.C0
		self.c1[j.name] = motor.C1
	end

	local c0, c1 = self.c0, self.c1

	-- standing pose relative to the HumanoidRootPart
	self.restLowerTorso = c0.Root * c1.Root:Inverse()
	self.restUpperTorso = self.restLowerTorso * c0.Waist * c1.Waist:Inverse()
	self.restTorsoRot = self.restUpperTorso.Rotation
	self.shoulderMid = (c0.LeftShoulder.Position + c0.RightShoulder.Position) / 2
	self.shoulderHalfWidth = math.abs(c0.LeftShoulder.Position.X - c0.RightShoulder.Position.X) / 2
	self.neckAboveShoulder = c0.Neck.Position.Y - self.shoulderMid.Y
	self.headHalfDepth = head.Size.Z / 2
	self.headHeight = head.Size.Y
	self.torsoHalfDepth = upperTorso.Size.Z / 2
	self.hrpHalfHeight = hrp.Size.Y / 2

	self.arms = {}
	for side, names in ARMS do
		local sh, el, wr = names[1], names[2], names[3]
		local u1 = c0[el].Position - c1[sh].Position
		local u2 = c0[wr].Position - c1[el].Position
		local u3 = -c1[wr].Position
		self.arms[side] = {
			l1 = u1.Magnitude,
			l2 = u2.Magnitude,
			l3 = u3.Magnitude,
			basis1 = basis(X_AXIS, unitOr(u1, -UP)),
			basis2 = basis(X_AXIS, unitOr(u2, -UP)),
			basis3 = basis(X_AXIS, unitOr(u3, -UP)),
		}
	end

	self.legs = {}
	for side, names in LEGS do
		local hip, knee, ankle = names[1], names[2], names[3]
		local u1 = c0[knee].Position - c1[hip].Position
		local u2 = c0[ankle].Position - c1[knee].Position
		local ankleFrame = self.restLowerTorso * c0[hip] * c1[hip]:Inverse() * c0[knee] * c1[knee]:Inverse()
			* c0[ankle]
		self.legs[side] = {
			l1 = u1.Magnitude,
			l2 = u2.Magnitude,
			-- legs bend the other way, so their hinge is -X
			basis1 = basis(-X_AXIS, unitOr(u1, -UP)),
			basis2 = basis(-X_AXIS, unitOr(u2, -UP)),
			restAnkle = ankleFrame.Position, -- relative to the HumanoidRootPart
			restFootRot = (ankleFrame * c1[ankle]:Inverse()).Rotation,
		}
	end

	return self
end

-- Height of the HumanoidRootPart centre above the floor while standing.
function PullUpRig:standHeight()
	return self.humanoid.HipHeight + self.hrpHalfHeight
end

-- World position of the point between the shoulders when standing at standCF.
function PullUpRig:standShoulder(standCF)
	return standCF * (self.restUpperTorso * self.shoulderMid)
end

---------------------------------------------------------------------------
-- bars
---------------------------------------------------------------------------

-- Reads a pull-up bar model. Returns the stand CFrame for this rig (where the
-- HumanoidRootPart is anchored, facing the bar) and the grip points for the
-- character's left and right hands.
function PullUpRig:barFrames(bar)
	local base = bar.PrimaryPart or bar:FindFirstChild("Base", true)
	local gripBar = bar:FindFirstChild("GripBar", true)
	if not (base and gripBar) then
		return nil
	end
	local stand = base:FindFirstChild("StandPoint")
	local ga = gripBar:FindFirstChild("GripLeft")
	local gb = gripBar:FindFirstChild("GripRight")
	if not (stand and ga and gb) then
		return nil
	end
	local baseCF = base.CFrame
	local up = baseCF.UpVector
	local facing = -baseCF.LookVector -- players face into the station
	local floor = (baseCF * stand.CFrame).Position
	local root = floor + up * self:standHeight()
	local standCF = CFrame.lookAt(root, root + facing, up)

	local pa = (gripBar.CFrame * ga.CFrame).Position
	local pb = (gripBar.CFrame * gb.CFrame).Position
	local right = standCF.RightVector
	local grips
	if (pa - pb):Dot(right) > 0 then
		grips = { Right = pa, Left = pb }
	else
		grips = { Right = pb, Left = pa }
	end
	return standCF, grips, floor
end

---------------------------------------------------------------------------
-- solving
---------------------------------------------------------------------------

--[[
	params:
		shoulder    Vector3  world point between the shoulders
		pitch       number   torso lean, + leans back (radians)
		roll        number   torso roll (radians)
		waist       number   upper torso bend over the hips, + arches back
		head        number   head pitch, + looks up
		grip        0..1     how much the hands follow the grips (0 = arms at rest)
		plant       0..1     how much the feet stay planted on the floor (IK)
		footOffset  Vector3  extra offset for planted feet
		hipL/hipR, kneeL/kneeR, ankleL/ankleR, splay   leg FK angles (radians)
]]
function PullUpRig:solve(standCF, grips, p)
	local c0, c1 = self.c0, self.c1
	local T = {}

	-- torso
	local torsoRot = standCF.Rotation * self.restTorsoRot * CFrame.Angles(p.pitch, 0, p.roll or 0)
	local UT = CFrame.new(p.shoulder) * torsoRot * CFrame.new(-self.shoulderMid)
	local waist = CFrame.Angles(p.waist, 0, 0)
	local LT = UT * c1.Waist * waist:Inverse() * c0.Waist:Inverse()
	T.Waist = waist
	T.Root = c0.Root:Inverse() * standCF:Inverse() * LT * c1.Root
	T.Neck = CFrame.Angles(p.head, 0, 0)

	-- arms: IK onto the grips
	local back = -standCF.LookVector
	local down = -standCF.UpVector
	for side, names in ARMS do
		local sh, el, wr = names[1], names[2], names[3]
		local info = self.arms[side]
		local S = (UT * c0[sh]).Position
		local G = grips[side]
		local W = G + unitOr(S - G, down) * info.l3
		local pole = S + standCF.RightVector * (names.sign * 1.4) + back * 0.5 + down * 0.6
		local E, W2, n = solveChain(S, W, info.l1, info.l2, pole)
		local UA = placeBone(S, E - S, n, info.basis1, c1[sh].Position)
		local LA = placeBone(E, W2 - E, n, info.basis2, c1[el].Position)
		local HA = placeBone(W2, unitOr(G - W2, W2 - E), n, info.basis3, c1[wr].Position)
		local w = p.grip
		T[sh] = IDENTITY:Lerp(c0[sh]:Inverse() * UT:Inverse() * UA * c1[sh], w)
		T[el] = IDENTITY:Lerp(c0[el]:Inverse() * UA:Inverse() * LA * c1[el], w)
		T[wr] = IDENTITY:Lerp(c0[wr]:Inverse() * LA:Inverse() * HA * c1[wr], w)
	end

	-- legs: FK while hanging, IK while the feet are planted
	for side, names in LEGS do
		local hip, knee, ankle = names[1], names[2], names[3]
		local isLeft = side == "Left"
		local fkHip = CFrame.Angles(isLeft and p.hipL or p.hipR, 0, names.sign * (p.splay or 0))
		local fkKnee = CFrame.Angles(-(isLeft and p.kneeL or p.kneeR), 0, 0)
		local fkAnkle = CFrame.Angles(-(isLeft and p.ankleL or p.ankleR), 0, 0)
		if p.plant > 1e-3 then
			local info = self.legs[side]
			local H = (LT * c0[hip]).Position
			local A = (standCF * info.restAnkle) + (p.footOffset or Vector3.new())
			local pole = H + standCF.LookVector * 2 + down * 0.5
			local K, A2, n = solveChain(H, A, info.l1, info.l2, pole)
			local UL = placeBone(H, K - H, n, info.basis1, c1[hip].Position)
			local LL = placeBone(K, A2 - K, n, info.basis2, c1[knee].Position)
			local FT = CFrame.new(A2) * standCF.Rotation * info.restFootRot * CFrame.new(-c1[ankle].Position)
			local w = p.plant
			T[hip] = fkHip:Lerp(c0[hip]:Inverse() * LT:Inverse() * UL * c1[hip], w)
			T[knee] = fkKnee:Lerp(c0[knee]:Inverse() * UL:Inverse() * LL * c1[knee], w)
			T[ankle] = fkAnkle:Lerp(c0[ankle]:Inverse() * LL:Inverse() * FT * c1[ankle], w)
		else
			T[hip] = fkHip
			T[knee] = fkKnee
			T[ankle] = fkAnkle
		end
	end

	return T
end

function PullUpRig:apply(T)
	for name, motor in self.motors do
		local t = T[name]
		if t then
			motor.Transform = t
		end
	end
end

-- Shared IK helpers (used by the throw animation too)
PullUpRig.basis = basis
PullUpRig.solveChain = solveChain
PullUpRig.placeBone = placeBone
PullUpRig.unitOr = unitOr

-- World CFrame of every body part for a set of transforms, with the
-- HumanoidRootPart at hrpCF.
function PullUpRig:fk(hrpCF, T)
	local world = { HumanoidRootPart = hrpCF }
	for _, j in PullUpRig.MOTORS do
		local motor = self.motors[j.name]
		local parent = world[motor.Part0.Name]
		world[j.part] = parent * self.c0[j.name] * (T[j.name] or IDENTITY) * self.c1[j.name]:Inverse()
	end
	return world
end

function PullUpRig:reset()
	for _, motor in self.motors do
		motor.Transform = IDENTITY
	end
end

return PullUpRig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">PullUpMotion</string><ProtectedString name="Source"><![CDATA[--!nonstrict
--[[
	PullUpMotion

	The choreography. Given a session (when it started, the tempo, when the
	player let go ...) and a time, returns the pose parameters PullUpRig:solve
	needs. Everything is a pure function of server time, so every client draws
	the same frame for the same moment and the motion stays in sync without
	streaming poses over the network.

	One session:
		mount     crouch, reach up, jump and catch the bar, settle      (MOUNT_TIME)
		reps      pull up -> squeeze at the top -> lower -> settle      (tempo per rep)
		dismount  let go, drop, absorb the landing, stand up            (DISMOUNT_TIME)
]]

local Motion = {}

Motion.MOUNT_TIME = 0.8
Motion.DISMOUNT_TIME = 0.75

local FALL = 0.3 -- drop until the feet touch
local ABSORB = 0.16 -- knees soak up the landing

-- Rep timing as fractions of one rep.
local UP_END = 0.36 -- chin reaches the bar
local HOLD_END = 0.48 -- squeeze at the top
local DOWN_END = 0.86 -- arms straight again; the rest is a small settle
Motion.TOP = (UP_END + HOLD_END) / 2 -- the moment a rep counts

local rad = math.rad
local sin = math.sin
local PI = math.pi

local function clamp01(x)
	return math.clamp(x, 0, 1)
end

-- zero velocity and acceleration at both ends: the core of the "fluid" feel
local function smoother(x)
	x = clamp01(x)
	return x * x * x * (x * (x * 6 - 15) + 10)
end

local function easeOutCubic(x)
	x = clamp01(x)
	local i = 1 - x
	return 1 - i * i * i
end

local function easeInQuad(x)
	x = clamp01(x)
	return x * x
end

local function lerp(a, b, t)
	return a + (b - a) * t
end

-- Body height through one rep: 0 = dead hang, 1 = chin over the bar.
function Motion.rise(p)
	if p < UP_END then
		return smoother(p / UP_END)
	elseif p < HOLD_END then
		local x = (p - UP_END) / (HOLD_END - UP_END)
		return 1 + 0.035 * sin(PI * x) ^ 2
	elseif p < DOWN_END then
		return 1 - smoother((p - HOLD_END) / (DOWN_END - HOLD_END))
	else
		local x = (p - DOWN_END) / (1 - DOWN_END)
		return -0.06 * sin(PI * x) ^ 2
	end
end

local function riseVelocity(p)
	local e = 1e-3
	return (Motion.rise(math.min(p + e, 0.9999)) - Motion.rise(math.max(p - e, 0))) / (2 * e)
end

---------------------------------------------------------------------------
-- parameter tables
---------------------------------------------------------------------------

local NUM_KEYS = {
	"pitch", "roll", "waist", "head", "grip", "plant", "splay",
	"hipL", "hipR", "kneeL", "kneeR", "ankleL", "ankleR",
}

local function blend(a, b, t)
	local out = {
		shoulder = a.shoulder:Lerp(b.shoulder, t),
		footOffset = a.footOffset:Lerp(b.footOffset, t),
	}
	for _, k in NUM_KEYS do
		out[k] = lerp(a[k], b[k], t)
	end
	return out
end
Motion.blend = blend

local function copy(a)
	return blend(a, a, 0)
end

---------------------------------------------------------------------------
-- context: everything that depends on the avatar + bar, computed once
---------------------------------------------------------------------------

function Motion.context(rig, standCF, grips, floor)
	local ctx = { rig = rig, standCF = standCF, grips = grips, floor = floor }
	local up = standCF.UpVector
	ctx.up = up
	ctx.look = standCF.LookVector
	ctx.gripMid = (grips.Left + grips.Right) / 2

	local armL, armR = rig.arms.Left, rig.arms.Right
	local reach = ((armL.l1 + armL.l2 + armL.l3) + (armR.l1 + armR.l2 + armR.l3)) / 2
	local gripHalf = (grips.Left - grips.Right).Magnitude / 2
	local dx = gripHalf - rig.shoulderHalfWidth

	-- how far the torso sits behind the bar (towards the camera), bottom and top.
	-- At the top the head and chest must clear the bar.
	ctx.backBottom = 0.35
	ctx.backTop = math.max(0.85, rig.headHalfDepth + 0.35, rig.torsoHalfDepth + 0.4)

	-- dead hang: arms almost straight
	local r = reach * 0.94 -- leaves room for the settle dip below dead hang
	local gripY = (ctx.gripMid - floor):Dot(up)
	local standShoulderH = (rig:standShoulder(standCF) - floor):Dot(up)
	-- keep the feet off the floor for very tall avatars
	local lowest = standShoulderH * 0.97 + 0.2 - gripY
	local function bottomFor(back)
		local vertical = math.sqrt(math.max(0.04, r * r - dx * dx - back * back))
		return math.max(-vertical, lowest)
	end
	ctx.dyBottom = bottomFor(ctx.backBottom)
	-- Short arms leave the head near the bar even at the bottom: hang further
	-- behind the bar so the head never touches it.
	local headTop = ctx.dyBottom + rig.neckAboveShoulder + rig.headHeight
	if headTop > -0.45 then
		ctx.backBottom = math.max(ctx.backBottom, rig.headHalfDepth + 0.38)
		ctx.dyBottom = bottomFor(ctx.backBottom)
	end
	-- top: the chin (neck joint) clears the bar
	ctx.dyTop = math.max(0.36 - rig.neckAboveShoulder, ctx.dyBottom + 0.6)

	ctx.standShoulder = rig:standShoulder(standCF)
	ctx.stand = {
		shoulder = ctx.standShoulder,
		footOffset = Vector3.new(),
		pitch = 0, roll = 0, waist = 0, head = 0, grip = 0, plant = 0, splay = 0,
		hipL = 0, hipR = 0, kneeL = 0, kneeR = 0, ankleL = 0, ankleR = 0,
	}
	ctx.crouch = copy(ctx.stand)
	ctx.crouch.shoulder = ctx.standShoulder - up * 0.45 + ctx.look * 0.12
	ctx.crouch.pitch = rad(-8)
	ctx.crouch.head = rad(14)
	ctx.crouch.plant = 1
	return ctx
end

---------------------------------------------------------------------------
-- hanging pose for a rise value
---------------------------------------------------------------------------

local function hang(ctx, r, v, t)
	local rc = clamp01(r)
	local kick = math.clamp(v / 5, -1, 1) -- + while pulling up, - while lowering
	local kickUp = math.max(kick, 0)
	local kickDown = math.max(-kick, 0)
	local sway = sin(t * 2 * PI / 2.8)

	local dy = lerp(ctx.dyBottom, ctx.dyTop, r)
	local back = lerp(ctx.backBottom, ctx.backTop, 1 - (1 - rc) ^ 2.6)
	return {
		shoulder = ctx.gripMid + ctx.up * dy - ctx.look * back,
		footOffset = Vector3.new(),
		pitch = rad(lerp(3, 13, rc) + 1.4 * sway - 3 * kickDown),
		roll = rad(0.8 * sin(t * 2 * PI / 3.7)),
		waist = rad(lerp(2, 7, rc)),
		-- look up at the bar on the way up, chin over at the top
		head = rad(lerp(12, 3, rc) + 14 * sin(PI * rc) * (1 - rc * 0.4)),
		grip = 1,
		plant = 0,
		splay = rad(3 + 2 * kickUp),
		-- knees bent, ankles crossed-ish, legs kick a little as you pull
		hipL = rad(14 + 12 * kickUp - 8 * kickDown + 3 * sway),
		hipR = rad(9 + 12 * kickUp - 8 * kickDown + 3 * sway),
		kneeL = rad(42 + 16 * kickUp - 6 * kickDown),
		kneeR = rad(30 + 16 * kickUp - 6 * kickDown),
		ankleL = rad(24),
		ankleR = rad(18),
	}
end

-- Rise and rise velocity at time `now` (no mount / dismount)
local function repState(s, now)
	if s.mode == "Tap" then
		if not s.repStart then
			return 0, 0
		end
		local p = (now - s.repStart) / s.tempo
		if p < 0 or p >= 1 then
			return 0, 0
		end
		return Motion.rise(p), riseVelocity(p)
	end
	local p = ((now - s.startTime) / s.tempo) % 1
	return Motion.rise(p), riseVelocity(p)
end

-- Mount + reps (everything except letting go)
local function sampleOnBar(ctx, s, now)
	local tau = now - s.mountStart
	local P
	if tau >= Motion.MOUNT_TIME then
		local r, v = repState(s, now)
		P = hang(ctx, r, v, now)
	else
		local hang0 = hang(ctx, 0, 0, s.mountStart + Motion.MOUNT_TIME)
		if tau < 0.26 then
			-- crouch and reach for the bar
			P = blend(ctx.stand, ctx.crouch, smoother(tau / 0.26))
		elseif tau < 0.66 then
			-- jump and catch
			local x = (tau - 0.26) / 0.4
			P = blend(ctx.crouch, hang0, 1 - (1 - x) ^ 2)
			P.shoulder += ctx.up * (0.06 * sin(PI * x))
			local tuck = rad(28) * sin(PI * x)
			P.kneeL += tuck
			P.kneeR += tuck
			P.hipL += tuck * 0.6
			P.hipR += tuck * 0.6
			P.plant = 1 - smoother(x / 0.65)
		else
			-- the catch: body swings and settles under the bar
			local x = (tau - 0.66) / (Motion.MOUNT_TIME - 0.66)
			P = hang(ctx, -0.07 * sin(PI * x) ^ 2, 0, now)
			P = blend(hang0, P, smoother(x * 3))
		end
		P.grip = smoother(tau / 0.48)
		-- slide in from wherever the player stood when they started
		if s.entry then
			local k = 1 - smoother(tau / 0.4)
			P.shoulder += s.entry * k
			P.footOffset += s.entry * k
		end
	end
	return P
end

function Motion.sample(ctx, s, now)
	if not s.dismountStart or now < s.dismountStart then
		return sampleOnBar(ctx, s, now)
	end
	local tau = now - s.dismountStart
	if tau >= Motion.DISMOUNT_TIME then
		return copy(ctx.stand)
	end
	local from = sampleOnBar(ctx, s, s.dismountStart)
	local up, look = ctx.up, ctx.look
	local touch = copy(ctx.stand)
	touch.shoulder = ctx.standShoulder - up * 0.05
	touch.pitch = rad(-4)
	touch.head = rad(6)
	touch.plant = 1
	local land = copy(ctx.crouch)
	land.shoulder = ctx.standShoulder - up * 0.55 + look * 0.05
	land.pitch = rad(-10)
	local release = from.grip * (1 - smoother(tau / 0.42))
	local P
	if tau < FALL then
		-- let go and drop; legs reach for the floor
		local x = tau / FALL
		local e = easeInQuad(x)
		-- drop first; lean and drift under the bar only once the head is below it
		P = blend(from, touch, x ^ 6)
		local delta = touch.shoulder - from.shoulder
		local vertical = up * delta:Dot(up)
		P.shoulder = from.shoulder + vertical * e + (delta - vertical) * (x ^ 6)
		P.plant = smoother((x - 0.15) / 0.85)
	elseif tau < FALL + ABSORB then
		-- knees soak up the landing
		local x = (tau - FALL) / ABSORB
		P = blend(touch, land, easeOutCubic(x))
	else
		-- stand back up
		local x = (tau - FALL - ABSORB) / (Motion.DISMOUNT_TIME - FALL - ABSORB)
		P = blend(land, ctx.stand, smoother(x))
		P.plant = 1 - smoother((x - 0.6) / 0.4)
	end
	P.grip = release
	return P
end

-- Whole seconds of motion for a session that is still running
function Motion.isDone(s, now)
	return s.dismountStart ~= nil and now >= s.dismountStart + Motion.DISMOUNT_TIME
end

return Motion
]]></ProtectedString></Properties></Item></Item></roblox>
